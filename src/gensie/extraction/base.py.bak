"""
Extraction  — Orchestrator.

Pipeline:
  1. SchemaOptimizer → field_metadata + optimized_schema
  2. DraftEngine → evidence + thinking + draft (2 LLM calls)
  3. Constrained Decoding → final JSON (1 LLM call, Draft-as-Context)
     └── Fallback: prompt-only if CD fails
  4. POST Validation → verified JSON (deterministic + optional LLM)
"""


import os
import copy
import dataclasses
from logging import getLogger
from typing import Any

from openai import OpenAI
from dotenv import load_dotenv

from gensie.agent import GenSIEAgent
from gensie.task import Task
from .optimizer import SchemaOptimizer, FieldMetadata

from .draft import DraftEngine
from .decoder import decode_to_json
from .verifier import validate_post

load_dotenv()
logger = getLogger("gensie")

class ExtractionAgent(GenSIEAgent):
    """Extraction v2 pipeline agent.

    Uses SchemaOptimizer + DraftEngine (2-phase) + Constrained Decoding
    (Draft-as-Context) + layered POST validation.
    """

    def __init__(self, pydantic_model_class: type | None = None):
        self.pydantic_model_class = pydantic_model_class
        self.client = OpenAI(
            base_url=os.getenv("OPENAI_BASE_URL"),
            api_key=os.getenv("OPENAI_API_KEY", "sk-dummy"),
        )

    def run(self, task: Task, model: str) -> dict[str, Any]:
        """Execute the full extraction pipeline for a Task.

        Args:
            task: The task with input_text, instruction, target_schema.
            model: Model name (provided by the evaluator).

        Returns:
            Dict with the extracted JSON.
        """
        raw_schema = task.target_schema
        input_text = task.input_text

        # ── FASE 0: Schema Optimization ────────────────────────────────
        logger.info("[extraction] Fase 0: Schema Optimization")
        field_metadata = self._build_field_metadata(raw_schema)
        optimized_schema = SchemaOptimizer.from_raw_schema(raw_schema)

        # ── FASE 1: Draft Generation ──────────────────────────────────
        logger.info("[extraction] Fase 1: Draft Generation")
        draft_engine = DraftEngine(client=self.client, model=model)
        evidence, thinking, draft = draft_engine.generate(
            field_metadata=field_metadata,
            optimized_schema=optimized_schema,
            input_text=input_text,
            instruction=task.instruction,
        )

        # ── FASE 2: Constrained Decoding ───────────────────────────────
        logger.info("[extraction] Fase 2: Constrained Decoding")
        result_json = decode_to_json(
            client=self.client,
            model=model,
            draft_json=draft,
            schema=optimized_schema,
        )

        # # ── FASE 3: POST Validation ────────────────────────────────────
        # logger.info("[extraction] Fase 3: POST Validation")
        # is_valid, errors, corrected = validate_post(
        #     result_json=result_json,
        #     schema=optimized_schema,
        #     input_text=input_text,
        #     pydantic_model=self.pydantic_model_class,
        # )

        # if not is_valid:
        #     logger.warning(
        #         f"[extraction] POST validation encontró {len(errors)} errores: "
        #         f"{errors[:3]}..."
        #     )

        # return corrected
        return result_json

    def _build_field_metadata(
        self,
        raw_schema: dict[str, Any],
    ) -> list[dict[str, Any]]:
        """Build simplified field metadata from the original schema.

        Uses ``SchemaOptimizer._resolve_refs`` and ``_extract_metadata``
        to produce metadata that respects the original ``required`` /
        nullable semantics — **before** ``_force_required`` flattens
        all properties into ``required``.

        This produces a flat list of plain dicts so the prompt templates
        (``build_field_descriptions``) can consume them directly.
        """
        # Work on a copy — never mutate the caller's schema
        schema_copy = copy.deepcopy(raw_schema)
        defs = schema_copy.pop("$defs", {})
        resolved = SchemaOptimizer._resolve_refs(schema_copy, defs)

        # Extract metadata using SchemaOptimizer's proven recursive logic
        metadata: list[FieldMetadata] = SchemaOptimizer._extract_metadata(resolved)

        # Convert dataclass objects → plain dicts for prompt templates
        return [dataclasses.asdict(md) for md in metadata]


